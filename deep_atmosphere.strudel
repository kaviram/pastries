// "Deep Atmosphere" - a layered electronic composition
// Paste into https://strudel.cc to play

// === DRUMS: deep kick with swing ===
$: sound(
  `
  bd ~ ~ bd:3
  ~ bd ~ ~
  bd ~ bd:2 ~
  ~ ~ bd ~
  `
).
  bank("RolandTR909").
  gain(0.9).
  shape(0.3).
  lpf(800).
  cpm(128/4)

// === HI-HATS: shuffled rhythm ===
$: sound(
  `
  hh*2 oh hh*4 hh
  hh oh hh*2 hh*3
  `
).
  bank("RolandTR909").
  gain("<0.5 0.6 0.7 0.6>").
  hpf(6000).
  pan(sine.range(0.3, 0.7).slow(4)).
  cpm(128/4)

// === CLAP: offbeat snare/clap ===
$: sound(
  `
  ~ cp ~ ~
  ~ cp ~ cp:2
  `
).
  bank("RolandTR909").
  gain(0.55).
  room(0.4).
  delay(0.15).
  delaytime(0.375).
  cpm(128/4)

// === BASS: deep sub with movement ===
$: note(
  `
  [d2 ~] ~ [d2 f2] ~
  [a1 ~] ~ [a1 c2] ~
  [g1 ~] ~ [g1 bb1] ~
  [a1 ~] ~ ~ [a1 d2]
  `
).
  sound("sawtooth").
  cutoff(sine.range(200, 900).slow(8)).
  resonance(12).
  gain(0.7).
  adsr("0.01:0.2:0.6:0.3").
  distort(0.08).
  cpm(128/4)

// === PAD: lush evolving chords ===
$: note(
  `
  <[d3,f3,a3,c4] [d3,f3,a3,c4] [c3,e3,g3,b3] [c3,e3,g3,b3]
   [bb2,d3,f3,a3] [bb2,d3,f3,a3] [a2,c3,e3,g3] [a2,c3,e3,g3]>
  `
).
  sound("triangle, sine").
  gain(0.25).
  lpf(sine.range(600, 2400).slow(16)).
  room(0.7).
  size(0.9).
  adsr("0.5:1:0.8:2").
  pan(sine.range(0.3, 0.7).slow(7)).
  cpm(128/4)

// === ARPEGGIO: sparkling melodic line ===
$: note(
  `
  <d4 f4 a4 c5 a4 f4 d4 c4
   c4 e4 g4 b4 g4 e4 c4 b3
   bb3 d4 f4 a4 f4 d4 bb3 a3
   a3 c4 e4 g4 e4 c4 a3 g3>
  `
).
  sound("square").
  gain(0.2).
  lpf(sine.range(1000, 4000).slow(12)).
  resonance(8).
  adsr("0.01:0.15:0.2:0.4").
  delay(0.4).
  delaytime(0.375).
  delayfeedback(0.45).
  room(0.5).
  pan(cosine.range(0.2, 0.8).slow(3)).
  cpm(128/4)

// === ATMOSPHERE: textural layer ===
$: note(
  `
  <[d5,a5] ~ ~ ~
   ~ [c5,g5] ~ ~
   ~ ~ [bb4,f5] ~
   ~ ~ ~ [a4,e5]>
  `
).
  sound("sine").
  gain(0.12).
  room(0.95).
  size(0.99).
  lpf(3000).
  adsr("0.8:0.5:0.6:3").
  delay(0.6).
  delaytime(0.75).
  delayfeedback(0.6).
  orbit(2).
  cpm(128/4)

// === PERC: organic textures ===
$: sound(
  `
  ~ [rim ~] ~ rim
  ~ ~ [rim:2 ~] ~
  `
).
  bank("RolandTR909").
  gain(0.3).
  room(0.6).
  delay(0.3).
  delaytime(0.25).
  delayfeedback(0.3).
  pan(rand.range(0.2, 0.8)).
  cpm(128/4)
